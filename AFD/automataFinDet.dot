digraph AFD { 
  rankdir=LR; 
  size="7";
  node [shape=circle];
  Q0     [label="Q0 (inicial)"];
  QDec   [label="QDec", shape=doublecircle];
  QCer   [label="QCer", shape=doublecircle];
  QOx    [label="QOx", shape=doublecircle];
  QOct   [label="QOct", shape=doublecircle];
  QHex   [label="QHex", shape=doublecircle];
  QERROR  [label="ERROR", shape=doublecircle];

  inicio [shape=point];
  inicio -> Q0;
  // Q0
  Q0 -> QDec  [label="1-7,8-9"];
  Q0 -> QCer  [label="0"];
  Q0 -> QERROR [label="λ"];
  // QDec
  QDec -> QDec  [label="0,1-7,8-9"];
  QDec -> QERROR [label="λ"];
  // QCer
  QCer->QOct [label="1-7"];
  QCer->QHex [label="8-9"];
  QCer->QOx   [label="Xx"];
  QCer->QHex  [label="A-F/a-f"];
  QCer -> QERROR [label="λ"];
  // QOx
  QOx->QHex [label="0"];
  QOx->QHex [label="1-7"];
  QOx->QHex [label="8-9"];
  QOx->QHex [label="A-F/a-f"];
  QOx -> QERROR [label="λ"];
  // QOct
  QOct-> QOct [label="0"];
  QOct-> QOct [label="1-7"];
  QOct-> QHex [label="8-9"];
  QOct-> QHex [label="A-F/a-f"];
  QOct -> QERROR [label="λ"];
  // QHex
  QHex-> QHex [label="0"];
  QHex-> QHex [label="1-7"];
  QHex-> QHex [label="8-9"];
  QHex-> QHex [label="A-F/a-f"];
  QHex -> QERROR [label="λ"];
  // QERROR
  QERROR -> QERROR [label="λ"];
} 