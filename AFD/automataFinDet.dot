digraph AFD { 
  rankdir=LR; 
  node [shape=circle];
  Q0     [label="Q0 (inicial)"];
  QDec   [label="QDec", shape=doublecircle];
  QCer   [label="QCer", shape=doublecircle];
  QOx    [label="QOx", shape=doublecircle];
  QOct   [label="QOct", shape=doublecircle];
  QHex   [label="QHex", shape=doublecircle];
  QERROR  [label="ERROR", shape=doublecircle];

  inicio [shape=point];
  inicio -> Q0;
  // Q0
  Q0 -> QDec  [label="1-7"];
  Q0 -> QDec  [label="8-9"];
  Q0 -> QCer  [label="0"];
  Q0 -> QERROR [label="λ"];
  // QDec
  QDec -> QDec  [label="0"];
  QDec -> QDec  [label="1-7"];
  QDec -> QDec  [label="8-9"];
  QDec -> QERROR [label="λ"];
  // QCer
  QCer->QOct
  QCer->QHex
  QCer->QOx
  QCer->QHex
  QCer -> QERROR [label="λ"];
  // QOx
  QOx->QHex
  QOx->QHex
  QOx->QHex
  QOx->QHex
  QOx -> QERROR [label="λ"];
  // QOct
  QOct-> QOct
  QOct-> QOct
  QOct-> QHex
  QOct-> QHex
  QOct -> QERROR [label="λ"];
  // QHex
  QHex-> QHex
  QHex-> QHex
  QHex-> QHex
  QHex-> QHex
  QHex -> QERROR [label="λ"];
  // QERROR
  QERROR -> QERROR [label="λ"];
} 