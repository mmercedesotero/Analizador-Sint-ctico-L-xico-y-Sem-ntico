digraph AFD { 
  rankdir=LR; 
  size="13";
  node [shape=circle];
  
  Q0     [label="Q0\n Inicio"];
  QDec   [label="QDec", shape=doublecircle];
  QCer   [label="QCer", shape=doublecircle];
  QOx    [label="QOx", ];
  QOct   [label="QOct", shape=doublecircle];
  QHex   [label="QHex", shape=doublecircle];
  QERROR  [label="ERROR"];

  //// ACLARACION TODO CAMBIO DE ESTADO QUE TIENE "," INDICA QUE n>1  DE CAMBIOS DE ESTADOS 
  inicio [shape=point];
  inicio -> Q0;

  // Q0
  Q0 -> QDec  [label="1-7,8-9"];
  Q0 -> QCer  [label="0"];
  Q0 -> QERROR [label="λ"];

  // QDec
  QDec -> QDec  [label="0,1-7,8-9"];
  QDec -> QERROR [label="λ"];

  // QCer
  QCer->QOct [label="1-7"];
  QCer->QOx  [label="Xx"];
  QCer->QHex [label="8-9,A-F/a-f"];
  QCer -> QERROR [label="λ"];

  // QOx
  QOx->QHex [label="0,1-7,8-9,A-F/a-f"];
  QOx -> QERROR [label="λ"];

  // QOct
  QOct-> QOct [label="0,1-7"];
  QOct-> QHex [label="8-9,A-F/a-f"]; 
  QOct -> QERROR [label="λ"];

  // QHex
  QHex-> QHex [label="0,1-7,8-9,A-F/a-f"];
  QHex -> QERROR [label="λ"];

  // QERROR
  QERROR -> QERROR [label="λ"];

} 